# 站1 构建上下文忽略清单
# 目的：镜像只装 Linux 版依赖与必要源码，排除 Windows 专用大文件、宿主依赖、
#       版本控制与运行时数据，避免 1.31GB 膨胀（meilisearch.exe 124M + win 版
#       node_modules 74M 等被 COPY backend/ 拖进镜像）。

# 版本控制 / 编辑器 / CI
.git
.gitignore
.gitattributes
.editorconfig
.vscode
.github

# 文档（运行镜像不需要）
*.md
docs
obsidian

# 宿主机依赖与构建产物：镜像内用 npm 重新装 Linux 版，
# 避免 win32 原生模块(.node)污染 Linux 容器
**/node_modules
app/dist

# 站1 后端的 Windows 专用大文件与本地搜索数据
# （meilisearch.exe 是 win 二进制，Linux 跑不了；meilisearch 服务未启用）
backend/bin
backend/meili_data

# 运行时数据 / 备份 / 辅助脚本（不进镜像，容器用挂载或独立服务）
data
dumps
scripts

# backend/.env 装的是真实密钥（ADMIN_TOKEN / NEO4J_PASSWORD 等），
# COPY backend/ ./ 会把它连镜像层一起带出去，任何拿到镜像的人都能读走。
# 运行时 dotenv 读的是 __dirname/.env（容器内 /app/.env），
# 而 compose 把仓库根 .env 挂在同一个路径上，镜像里那份从来没被用到——排除它不改行为。
backend/.env
